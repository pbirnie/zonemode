# Dependencies (Bun install)
node_modules/

# Bun local cache and the optional binary lockfile.
# bun.lock (text) is committed.
.bun/
bun.lockb

# TypeScript incremental cache (tsconfig noEmit; bun bundles to dist/)
*.tsbuildinfo

# Extension build output (bun run build)
dist/
build/

# Packed extension artifacts and Chrome packaging keys
*.zip
*.crx
*.pem

# Native binaries (Bun/toolchain drop these outside source)
*.exe
*.dll
*.node

# Env and secrets
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Test / coverage
coverage/
.nyc_output/
*.lcov

# Caches
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Editors and OS
.vscode/
.idea/
.vscode-test/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini
