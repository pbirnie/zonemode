{
  "manifest_version": 3,
  "name": "ZoneMode",
  "version": "1.0.8",
  "description": "Generate AI summaries of YouTube videos",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "permissions": ["storage", "activeTab", "tabs", "windows", "offscreen"],
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content/index.js"],
      "css": ["content/styles.css"]
    }
  ],
  "background": {
    "service_worker": "background/index.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["content/index.js.map"],
      "matches": ["*://*.youtube.com/*"]
    }
  ]
}
